{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spatial",
  "version": "0.1.0",
  "identifier": "ai.spatial.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "Spatial overlay",
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": true
      },
      {
        "label": "panel",
        "url": "panel.html",
        "title": "Spatial",
        "width": 420,
        "height": 520,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true
      },
      {
        "label": "dashboard",
        "url": "dashboard.html",
        "title": "Spatial",
        "width": 960,
        "height": 680,
        "minWidth": 640,
        "minHeight": 480,
        "visible": false,
        "decorations": true,
        "resizable": true,
        "center": true
      },
      {
        "label": "reminder",
        "url": "reminder.html",
        "title": "Spatial Reminder",
        "width": 340,
        "height": 190,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "focusable": false
      },
      {
        "label": "dictate",
        "url": "dictate.html",
        "title": "Spatial Dictation",
        "width": 300,
        "height": 72,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico", "icons/icon.png"] }
}
