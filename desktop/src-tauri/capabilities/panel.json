{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "panel",
  "description": "Ask panel: places itself beside the mark, takes focus, drags by its header, opens cited http(s) sources.",
  "windows": [
    "panel"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-set-position",
    "core:window:allow-start-dragging",
    "opener:allow-default-urls",
    "allow-own-pid",
    "allow-desktop-token",
    "allow-pairing-token"
  ]
}
