{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "dictate",
  "description": "Dictation pill: non-focusable; may position/show/hide itself, insert dictated text into the recorded target and arm Esc.",
  "windows": [
    "dictate"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-position",
    "allow-paste-dictation",
    "allow-set-dictation-active",
    "allow-desktop-token",
    "allow-pairing-token"
  ]
}
