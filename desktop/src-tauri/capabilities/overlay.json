{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlay",
  "description": "Freeze-frame overlay: shows/hides itself, sizes to the monitor, takes focus to draw, hides the Ask panel.",
  "windows": [
    "overlay"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "allow-desktop-token",
    "allow-pairing-token"
  ]
}
