# Provider order: first configured provider that answers wins. Remove names you do not use.
SPATIAL_PROVIDERS=ollama,openrouter,nvidia,openai,anthropic

# --- Local (free, private) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_VISION_MODEL=qwen2.5vl:3b        # ollama pull qwen2.5vl:3b (leave empty for text-only + OCR)

# --- OpenRouter (free tier models end in :free; key from https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-4b:free
OPENROUTER_VISION_MODEL=qwen/qwen2.5-vl-72b-instruct:free

# --- NVIDIA NIM (free credits at https://build.nvidia.com; key starts with nvapi-) ---
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b     # reasons, then answers in ~2-4 s (2026-09-24 probe)
NVIDIA_FALLBACK_MODELS=z-ai/glm-5.3,meta/muse-glimmer-30b   # comma list, tried when the main model is busy x3 / slow / gone
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct

# --- Paid clouds ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Server ---
SPATIAL_HOST=127.0.0.1
SPATIAL_PORT=8787
SPATIAL_API_TOKEN=                       # optional shared secret; extension sends it as Bearer
SPATIAL_PROVIDER_ATTEMPTS=3              # tries per model on busy errors (429/5xx/connection)
SPATIAL_TIMEOUT_SECONDS=60
SPATIAL_OCR=1                            # OCR the crop for text-only models (rapidocr)

# --- Audio (CPU) ---
SPATIAL_STT_MODEL=base                   # faster-whisper size: tiny | base | small
SPATIAL_STT_DEVICE=cpu
SPATIAL_TTS=1
SPATIAL_TTS_VOICE=alba
SPATIAL_AUDIO_IDLE_UNLOAD_SECONDS=300     # drop whisper/TTS from RAM after idle; 0 keeps them loaded
SPATIAL_FORCE_IPV4=0                     # set 1 if Hugging Face downloads stall (broken IPv6 route)

# --- Research search (Tavily; DuckDuckGo fallback when no key) ---
TAVILY_API_KEY=                          # https://app.tavily.com (free: 1000 searches/month)
SPATIAL_RESEARCH_SEARCH=auto             # auto | tavily | ddg
SPATIAL_RESEARCH_VERIFY=on               # Jev checks each cited source supports its sentence

# --- System One judgments (which object? ambiguous? needs research?) — sub-project 2 ---
TYPESAFE_API_KEY=                        # Jev, https://docs.typesafe.ai ; also export in shell for experiments
TYPESAFE_MODEL=jev-latest
LAYA_API_KEY=                            # optional: Laya hosted by impossibl (same /v1/systemone protocol)
LAYA_BASE_URL=https://api.impossibl.com  # or http://127.0.0.1:8000 for self-hosted laya-serve

# --- Trace log (opt-in; question, answer, what was resolved — never images) ---
SPATIAL_TRACE=off                        # on | off (the extension popup can also toggle it)
SPATIAL_LOG_DIR=                         # default: %APPDATA%\Spatial\logs (Windows)
SPATIAL_TRACE_MAX_MB=50
SPATIAL_TRACE_RETENTION_DAYS=14
SPATIAL_SYSTEM_ONE=                      # jev | off (default: jev when TYPESAFE_API_KEY is set)
SPATIAL_SYSTEM_ONE_TIMEOUT=1.5           # seconds; on timeout the ask falls back to geometry only
TYPESAFE_BASE_URL=https://api.typesafe.ai
